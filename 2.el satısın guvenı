<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pasaj - İkinci El Pazaryeri</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        [x-cloak] { display: none !important; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        body { padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); }
    </style>
</head>
<body class="bg-gray-100 font-sans select-none" x-data="{ activeTab: 'home', showDetail: false, selectedProduct: null }">

    <div class="max-w-md mx-auto bg-[#edf6f9] min-h-screen relative shadow-2xl overflow-hidden flex flex-col">
        
        <header class="bg-white px-6 pt-10 pb-4 flex justify-between items-center sticky top-0 z-40">
            <h1 class="text-2xl font-bold text-[#006d77]">PASAJ</h1>
            <div class="flex gap-4 text-xl">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-regular fa-bell"></i>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto pb-24 px-6">
            <div x-show="activeTab === 'home'" x-cloak>
                <div class="relative mt-4 mb-6">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" placeholder="İstediğin her şeyi ara..." class="w-full bg-white rounded-2xl py-3 pl-12 pr-4 shadow-sm outline-none">
                </div>
                <h2 class="text-xl font-bold mb-4 text-gray-800">Sana Özel</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div @click="showDetail = true" class="bg-white rounded-3xl p-3 shadow-sm active:scale-95 transition-transform">
                        <div class="h-32 bg-gray-200 rounded-2xl mb-2 overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff" class="w-full h-full object-cover">
                        </div>
                        <h3 class="font-bold text-sm">Spor Ayakkabı</h3>
                        <p class="text-[#006d77] font-bold">1.250 TL</p>
                    </div>
                </div>
            </div>
        </main>

        <nav class="absolute bottom-0 left-0 right-0 bg-white/90 backdrop-blur-md px-10 py-4 border-t flex justify-between items-center z-50">
            <button @click="activeTab = 'home'" :class="activeTab === 'home' ? 'text-[#006d77]' : 'text-gray-400'">
                <i class="fa-solid fa-house text-xl"></i>
            </button>
            <button @click="activeTab = 'sell'" class="bg-[#006d77] text-white w-12 h-12 rounded-2xl -mt-10 shadow-xl flex items-center justify-center">
                <i class="fa-solid fa-plus text-xl"></i>
            </button>
            <button @click="activeTab = 'profile'" :class="activeTab === 'profile' ? 'text-[#006d77]' : 'text-gray-400'">
                <i class="fa-solid fa-user text-xl"></i>
            </button>
        </nav>
    </div>

</body>
</html>
